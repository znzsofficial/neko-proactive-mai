{
  "manifest_version": 2,
  "version": "2.1.0",
  "name": "Neko Proactive Mai",
  "description": "MaiBot主动聊天调度：按白名单、时段、概率和冷却，把群聊/私聊意图交给Planner决定。",
  "author": {
    "name": "NekoLaska",
    "url": "https://github.com/znzsofficial"
  },
  "license": "AGPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/znzsofficial/neko-proactive-mai",
    "homepage": "https://github.com/znzsofficial/neko-proactive-mai",
    "issues": "https://github.com/znzsofficial/neko-proactive-mai/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.3.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "chat.get_stream_by_group_id",
    "chat.get_stream_by_user_id",
    "message.get_by_time_in_chat",
    "config.get",
    "maisaka.proactive.trigger",
    "api.call"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  },
  "id": "neko.proactive"
}
